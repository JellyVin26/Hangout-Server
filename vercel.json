{
  "version": 2,
  "buildCommand": "node scripts/prepare-vercel.js && npx prisma db push --schema prisma/schema.postgres.prisma && npm run build",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/notifications/reminders/run", "schedule": "0 9 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
