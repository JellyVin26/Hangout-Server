{
  "version": 2,
  "buildCommand": "node scripts/prepare-vercel.js && npm run build",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/docs", "dest": "/api/index" },
    { "src": "/docs/(.*)", "dest": "/api/index" },
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
